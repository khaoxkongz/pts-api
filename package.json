{
  "name": "pts-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc && tsc-alias --outDir ./dist",
    "start": "NODE_ENV=production node dist/src/main.js",
    "format:check": "vp fmt --check",
    "format:write": "vp fmt --write"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/eden": "^1.4.5",
    "@elysiajs/node": "^1.4.2",
    "@elysiajs/openapi": "^1.4.11",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "elysia": "^1.4.17",
    "exceljs": "^4.4.0",
    "lru-cache": "^11.5.2",
    "luxon": "^3.7.2",
    "mongoose": "^9.8.0",
    "p-limit": "^7.3.1",
    "slug": "^12.0.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.1",
    "@types/slug": "^5.0.9",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "download"
    }
  }
}
